pipeline{
  agent any
  environment{
	PATH = "$PATH:/opt/apache-maven-3.9.11/bin"
  }
	stages{
        stage("Git Checkout") {
            steps {
                git credentialsId: 'github', url: 'https://github.com/goldorak74-benise/jenkins_myweb'
            }
        }
		stage("Maven Build") {
            steps {
                sh "mvn clean package"
				sh "mv target/*.war target/myweb.war"
            }
        }
		stage("deploy-dev") {
            steps {
                sshagent(['Jenkins-tomcat']) {
				    ssh """
						scp -o StrictHostKeyChecking=no target/myweb.war benise@192.168.178.61:/opt/tomcat9/webapps
						ssh benise@192.168.178.61 /opt/tomcat9/bin/shutdown.sh
						ssh benise@192.168.178.61 /opt/tomcat9/bin/startup.sh
					"""
				}
            }
        }
	}
}
